theorem catalogue_length : catalogue.length = 37 := by decide

/-- ⭐ every listed class really is a doubly regular tournament DRT(23,11,5). -/
theorem catalogue_all_drt :
    catalogue.all (fun t => isTournament t && isRegular11 t && isDoublyRegular5 t) = true := by
  decide

/-- ⭐ EXACTLY TWO of the 37 carry S3: zero-indexed lines 34 and 35. This is the
step the packages state as "independently re-identifies rows 35 and 36 as the
only S3 cores", now kernel-checked rather than Python-checked. -/
theorem catalogue_s3_rows :
    (List.range 37).filter (fun i => hasS3 (catalogue.getD i [])) = [34, 35] := by
  decide

