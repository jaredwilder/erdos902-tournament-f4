def outM (t : List Nat) (v : Nat) : Nat := t.getD v 0
def bit (m v : Nat) : Bool := (m >>> v) % 2 == 1
def sMask (a b c : Nat) : Nat := (1 <<< a) ||| (1 <<< b) ||| (1 <<< c)

/-- some vertex outside `s` beats every member of `s`. -/
def dominated (t : List Nat) (s : Nat) : Bool :=
  (List.range 23).any fun v => (!(bit s v)) && ((outM t v) &&& s == s)

/-- S3 as used in f4_finite.lean: every 3-subset has a dominator. -/
def hasS3 (t : List Nat) : Bool :=
  (List.range 23).all fun a => (List.range 23).all fun b => (List.range 23).all fun c =>
    (a >= b || b >= c) || dominated t (sMask a b c)

/-- there are exactly 35 certificates, one per non-surviving row. -/
theorem rejects_count : rejects.length = 35 := by decide

/-- every certificate names a row other than 34 and 35 (0-indexed = rows 35, 36). -/
theorem rejects_avoid_survivors :
    (rejects.all fun r => r.1 != 34 && r.1 != 35) = true := by decide

/-- the 35 rejected rows are pairwise distinct, so all 35 non-survivors are covered. -/
theorem rejects_distinct :
    ((rejects.map (fun r => r.1)).eraseDups).length = 35 := by decide

/-- ⭐ EVERY certificate is valid: the named triple has NO dominator in its row. -/
theorem all_rejects_valid :
    (rejects.all fun r =>
      !(dominated (catalogue.getD r.1 []) (sMask r.2.1 r.2.2.1 r.2.2.2))) = true := by
  decide

/-- the two survivors do have S3, re-checked here against the same catalogue. -/
theorem survivor34_s3 : hasS3 (catalogue.getD 34 []) = true := by native_decide
theorem survivor35_s3 : hasS3 (catalogue.getD 35 []) = true := by native_decide

